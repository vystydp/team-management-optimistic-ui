# Frontend environment variables (Vite).
#
# None of these are required to run the app: by default it runs in DEMO MODE
# with mocked data (MSW) and a stubbed demo user — just `npm run dev`.
#
# Set these only if you want to run against the real backend (see README).

# Opt into the real backend. When 'true', MSW and the demo user are disabled
# and the app calls the backend directly. Leave unset/false for demo mode.
# VITE_USE_REAL_BACKEND=true

# Base URL of the backend API (defaults to http://localhost:3001 in dev).
# VITE_API_URL=http://localhost:3001
